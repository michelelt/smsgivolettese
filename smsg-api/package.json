{
  "name": "smsg-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "vitest run src",
    "test:db": "vitest run test",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "superadmin": "tsx --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local scripts/bootstrap-superadmin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@supabase/supabase-js": "^2.117.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
