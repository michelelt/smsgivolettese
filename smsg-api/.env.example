# Copied to .env.local by `make setup`. Local Supabase values go in .env.development.local (generated by `make dev`).
LOG_LEVEL=info                       # debug | info | warn | error
# Phase 2+ (optional until used). Local values for the three Supabase vars come from .env.development.local;
# keep them commented here, an empty assignment would override them.
# DATABASE_URL=                        # Supavisor transaction pooler (6543)
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=                 # service role / sb_secret_...; used only in src/lib/supabase-admin.ts
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Cloudflare always-pass test secret (local only)
RESEND_API_KEY=                       # empty locally: emails are only logged (email.skipped); required in production
EMAIL_FROM=                           # e.g. SMS Givolettese <noreply@your-domain>; required in production
CRON_SECRET=                          # >= 16 chars; Bearer token for GET /cron/daily; required in production
REVALIDATE_SECRET=dev-revalidate-secret
API_PROXY_SECRET=dev-proxy-secret     # shared with web proxy.ts (ADR-040)
WEB_URL=http://localhost:3000
# SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD (for `pnpm superadmin`) live in the workspace secrets.env (ADR-027), not here.
