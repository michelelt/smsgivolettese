{
  "openapi": "3.1.0",
  "info": {
    "title": "SMS Givolettese API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "volontario",
              "staff",
              "super_admin"
            ]
          }
        },
        "required": [
          "id",
          "role"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Servizio attivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "me"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Utente corrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Non autenticato"
          },
          "403": {
            "description": "Nessun ruolo attivo"
          }
        }
      }
    },
    "/public/services": {
      "get": {
        "tags": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "Servizi attivi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true
                          },
                          "scheduleNote": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "description",
                          "scheduleNote"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/public/site-settings": {
      "get": {
        "tags": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "Impostazioni del sito",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string",
                      "nullable": true
                    },
                    "slogan": {
                      "type": "string",
                      "nullable": true
                    },
                    "homeIntro": {
                      "type": "string",
                      "nullable": true
                    },
                    "vatNumber": {
                      "type": "string",
                      "nullable": true
                    },
                    "conventions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "maxLength": 500,
                            "format": "uri"
                          }
                        },
                        "required": [
                          "title",
                          "description"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "footerLinks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "group": {
                            "type": "string",
                            "enum": [
                              "associazioni",
                              "mutuo_soccorso",
                              "utili"
                            ]
                          },
                          "label": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "maxLength": 500,
                            "format": "uri"
                          }
                        },
                        "required": [
                          "group",
                          "label",
                          "url"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "address",
                    "slogan",
                    "homeIntro",
                    "vatNumber",
                    "conventions",
                    "footerLinks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
