{
  "openapi": "3.1.0",
  "info": {
    "title": "SMS Givolettese API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "volontario",
              "staff",
              "super_admin"
            ]
          }
        },
        "required": [
          "id",
          "role"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Servizio attivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "me"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Utente corrente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Non autenticato"
          },
          "403": {
            "description": "Nessun ruolo attivo"
          }
        }
      }
    },
    "/public/services": {
      "get": {
        "tags": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "Servizi attivi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true
                          },
                          "memberPriceCents": {
                            "type": "integer"
                          },
                          "nonMemberPriceCents": {
                            "type": "integer"
                          },
                          "scheduleNote": {
                            "type": "string",
                            "nullable": true
                          },
                          "bookable": {
                            "type": "boolean"
                          },
                          "requiresTransport": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "description",
                          "memberPriceCents",
                          "nonMemberPriceCents",
                          "scheduleNote",
                          "bookable",
                          "requiresTransport"
                        ]
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/public/site-settings": {
      "get": {
        "tags": [
          "public"
        ],
        "responses": {
          "200": {
            "description": "Impostazioni del sito",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "phone": {
                      "type": "string",
                      "nullable": true
                    },
                    "email": {
                      "type": "string",
                      "nullable": true
                    },
                    "address": {
                      "type": "string",
                      "nullable": true
                    },
                    "openingHours": {
                      "type": "string",
                      "nullable": true
                    },
                    "slogan": {
                      "type": "string",
                      "nullable": true
                    },
                    "homeIntro": {
                      "type": "string",
                      "nullable": true
                    },
                    "membershipInfo": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "phone",
                    "email",
                    "address",
                    "openingHours",
                    "slogan",
                    "homeIntro",
                    "membershipInfo"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/public/bookings": {
      "post": {
        "tags": [
          "public"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "serviceId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "day": {
                    "type": "string",
                    "format": "date"
                  },
                  "slot": {
                    "type": "string",
                    "enum": [
                      "mattina",
                      "pomeriggio"
                    ]
                  },
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 30
                  },
                  "declaredMember": {
                    "type": "boolean"
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 600
                  },
                  "turnstileToken": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "required": [
                  "serviceId",
                  "day",
                  "slot",
                  "firstName",
                  "lastName",
                  "phone",
                  "declaredMember",
                  "turnstileToken"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Prenotazione creata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR o TURNSTILE_FAILED"
          },
          "422": {
            "description": "INVALID_DAY o SERVICE_NOT_BOOKABLE"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        }
      }
    }
  }
}
