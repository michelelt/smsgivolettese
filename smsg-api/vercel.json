{
  "regions": ["fra1"],
  "buildCommand": "",
  "functions": {
    "api/index.ts": {
      "includeFiles": "assets/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/cron/daily",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
