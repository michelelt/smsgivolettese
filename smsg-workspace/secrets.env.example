# Local secrets for the workspace. Copy to `secrets.env` (git-ignored) and run `chmod 600 secrets.env`.
# Loaded by the Makefile with `set -a; . ./secrets.env; set +a` (shell syntax: quote values with single quotes).
# CI does not read this file: it uses GitHub Actions secrets.

# First super admin, created by `make superadmin`.
# The password is used ONLY when the account is created; the script never overwrites it.
# After the first login the super admin changes it in the app; nobody else can.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=''

# Supabase database passwords (Project Settings → Database), used by `supabase link` / `db push`.
SUPABASE_DB_PASSWORD_STAGING=''
SUPABASE_DB_PASSWORD_PROD=''
