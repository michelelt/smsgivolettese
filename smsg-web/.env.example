# Copy to .env.local (make setup does it). `make dev` also writes .env.development.local with local Supabase values.

# Rewrite target for /api/* and server-side fetches (API on :3001 locally).
API_URL=http://localhost:3001

# Supabase (auth/session only). Public values, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public forms). OPTIONAL: unset in production = no widget, API relies on per-IP rate limiting.
# Value below is Cloudflare always-pass test key, local only (rejected in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Shared with the API; protects the ISR webhook app/hooks/revalidate. Required (16+ chars) in production.
REVALIDATE_SECRET=dev-revalidate-secret

# Shared with the API: proves x-client-ip comes from proxy.ts (ADR-040). Required (16+ chars) in production.
API_PROXY_SECRET=dev-proxy-secret

# Public origin, for sitemap/robots/Open Graph. Required in production.
SITE_URL=http://localhost:3000

# Playwright (pnpm e2e): demo users from api/supabase/seed.sql. Fake, local only.
E2E_STAFF_EMAIL=staff.esempio@example.test
E2E_VOLUNTEER_EMAIL=volontario.esempio@example.test
E2E_ADMIN_EMAIL=admin.esempio@example.test
E2E_PASSWORD=Esempio-Locale-123!
