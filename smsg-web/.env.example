# Copy to .env.local (make setup does it). `make dev` also writes .env.development.local with local Supabase values.

# Rewrite target for /api/* and server-side fetches (API on :3001 locally).
API_URL=http://localhost:3001

# Supabase (auth/session only). Public values, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public forms; later phase). Use the test key locally: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared with the API; protects the ISR webhook app/hooks/revalidate (later phase).
REVALIDATE_SECRET=

# Playwright (pnpm e2e): demo users from api/supabase/seed.sql. Fake, local only.
E2E_STAFF_EMAIL=staff.esempio@example.test
E2E_VOLUNTEER_EMAIL=volontario.esempio@example.test
E2E_ADMIN_EMAIL=admin.esempio@example.test
E2E_PASSWORD=Esempio-Locale-123!
